# Copy to .env and fill in.

DATABASE_URL=postgres://booktrakd:booktrakd@localhost:5432/booktrakd

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Open Library asks API users to identify themselves with an app name + contact.
OL_USER_AGENT=booktrakd/0.1 (you@example.com)

# Cover storage. Leave R2_* empty to store covers on disk in .data/covers (dev only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=booktrakd-images

# Where the Open Library dumps are downloaded to.
DATA_DIR=.data
